# Bind the API to the container interface; Compose exposes it on host loopback only.
AGENT_FORGE_HOST=0.0.0.0
AGENT_FORGE_PORT=8090
AGENT_FORGE_DB=/data/agent-forge.db

# Required operator API credential. Keep empty in this template; set a secret out-of-band.
AGENT_FORGE_API_TOKEN=

# Required explicit private/reachable ZynxAGI service URL; do not use localhost across containers.
ZYNXAGI_BASE_URL=
# Service-to-service credential shared only by Agent Forge and ZynxAGI.
ZYNXAGI_AGENT_API_TOKEN=

# Exact browser origins allowed to call the API. Set the final Vercel Preview origin here.
AGENT_FORGE_CORS=http://localhost:5173

# Optional provider credentials; configure only when a provider is intentionally enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
DEFAULT_MODEL_PROVIDER=openai
