{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "es2020",
    "target": "es2020",
    "verbatimModuleSyntax": false,
    "types": ["jest", "@types/jest", "@testing-library/jest-dom", "node"]
  },
  "include": [
    "src/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest.setup.ts"
  ]
}