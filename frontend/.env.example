# Frontend Backend API Base URL
# Optional: Leave unset on Netlify to use the built-in Netlify Serverless API (/api/v1/*)
# on the same domain (https://zynx-agi.netlify.app).
#
# For local development with FastAPI (`uvicorn zynx_agi.main:app`), defaults to http://localhost:8000:
VITE_API_URL=http://localhost:8000
