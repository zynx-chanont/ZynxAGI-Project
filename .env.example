# Application Settings
APP_NAME=ZynxAGI
APP_VERSION=1.0.0
DEBUG=False

# Unified AI Provider Configuration (Backend Only - NEVER expose in frontend)
# Supported AI_PROVIDER values: openai, anthropic, google, auto, mock
AI_PROVIDER=auto
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=

# Provider-Specific API Keys (Optional alternatives to AI_API_KEY)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT=20

# CORS Configuration (comma-separated or JSON array; wildcard '*' rejected when DEBUG=False)
ALLOWED_ORIGINS=https://zynx-agi.netlify.app,http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://zynxuser:zynxpass@localhost:5432/zynxagi
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cultural Intelligence
CULTURAL_INTELLIGENCE_MODEL=deeja-v1
THAI_CULTURAL_WEIGHT=0.8
DEFAULT_CULTURAL_THRESHOLD=0.7

# Performance
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
CACHE_TTL=3600
