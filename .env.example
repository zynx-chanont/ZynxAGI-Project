# Application Settings
APP_NAME=ZynxAGI
APP_VERSION=1.0.0
DEBUG=True
APP_SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://zynxuser:zynxpass@postgres:5432/zynxagi
POSTGRES_DB=zynxagi
POSTGRES_USER=zynxuser
POSTGRES_PASSWORD=zynxpass

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# MinIO Configuration (S3-compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zynx-artifacts
MINIO_USE_SSL=false

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# Cultural Intelligence
CULTURAL_INTELLIGENCE_MODEL=deeja-v1
THAI_CULTURAL_WEIGHT=0.8
DEFAULT_CULTURAL_THRESHOLD=0.7

# Performance
REQUEST_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=100
CACHE_TTL=3600
